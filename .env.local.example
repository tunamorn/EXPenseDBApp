# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของโปรเจกต์ Supabase ของคุณ
#   cp .env.local.example .env.local
#
# หาค่าได้ที่ Supabase Dashboard > Project Settings > API
#   NEXT_PUBLIC_SUPABASE_URL       = Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = anon public key
#
# หมายเหตุ: ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ จะถูกฝังลงใน bundle ฝั่งเบราว์เซอร์ตอน build
# จึงเป็นข้อมูลสาธารณะ ห้ามใส่ service role key หรือ secret อื่นในตัวแปรกลุ่มนี้

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
