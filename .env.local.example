# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของโปรเจกต์คุณ
#   cp .env.local.example .env.local
#
# ---------------------------------------------------------------
# URL ของโปรเจกต์ Supabase — ไม่ใช่ความลับ
# หาได้ที่ Supabase Dashboard > Project Settings > Data API > Project URL
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# ---------------------------------------------------------------
# service role key — ใช้ฝั่ง server เท่านั้น
# หาได้ที่ Supabase Dashboard > Project Settings > API Keys > service_role (กด Reveal)
#
# ⚠️ key นี้ข้าม RLS ได้ทุกอย่าง เท่ากับกุญแจผีของฐานข้อมูล
#    - ห้ามเปลี่ยนชื่อเป็น NEXT_PUBLIC_ เพราะจะถูกฝังลง bundle ฝั่งเบราว์เซอร์
#    - ห้าม commit ค่าจริงขึ้น git (ไฟล์ .env.local อยู่ใน .gitignore แล้ว)
#    - ถ้าหลุด ให้กด Roll ที่หน้า Dashboard ทันที
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# กุญแจสำหรับเซ็นคุกกี้ session — สุ่มขึ้นมาเองได้เลย ไม่ต้องขอจากที่ไหน
# สร้างค่าใหม่ด้วยคำสั่งนี้:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ถ้าเปลี่ยนค่านี้ ผู้ใช้ทุกคนจะถูกบังคับให้ล็อกอินใหม่
# ---------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------
# โค้ดเชิญสำหรับสมัครสมาชิกที่หน้า /register — ตั้งเป็นอะไรก็ได้ที่เดายาก
# ส่งโค้ดนี้ให้คนที่คุณอนุญาตให้ใช้แอป แล้วเขาจะตั้งรหัสผ่านของตัวเอง
# คุณจึงไม่ต้องรู้รหัสผ่านของใครและไม่ต้องส่งรหัสผ่านผ่านแชต
#
# ปล่อยว่างไว้ = ปิดรับสมัครสมาชิก (หน้า /register จะขึ้นว่าปิดรับสมัคร)
# เปลี่ยนค่าได้ตลอด โค้ดเดิมจะใช้ไม่ได้ทันที ผู้ใช้ที่สมัครไปแล้วไม่กระทบ
# ---------------------------------------------------------------
REGISTER_INVITE_CODE=
